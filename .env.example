# ── PostgreSQL (container local) ──
POSTGRES_USER=recoltes
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=recoltes

# ── Database URL (utilisée par Prisma / Next.js) ──
# "db" = nom du service dans docker-compose.yml
DATABASE_URL="postgresql://recoltes:CHANGE_ME_strong_password_here@db:5432/recoltes?sslmode=disable"

# ── Auth.js ──
# Générer avec : openssl rand -base64 32
AUTH_SECRET="votre-secret-ici"

# URL publique de l'app (ton domaine)
AUTH_URL="https://ton-domaine.fr"

# ── Bootstrap (scripts/create-admin.mjs ou npm run create-admin) ──
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choisir_un_mot_de_passe_fort
# ORG_NAME="Nom de la mosquée / association"
#
# Données initiales Mosquée Savigny + Gentilly (mots de passe dans le script) :
#   npm run seed:orgs-users
